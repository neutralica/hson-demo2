{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hson-demo2-hosted-tests",
  "main": "src/server/cloudflare/worker.ts",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      {
        "name": "HOSTED_TESTS",
        "class_name": "HostedTestDurableObject"
      }
    ]
  },
  "limits": {
    "cpu_ms": 30000
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false
    }
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["HostedTestDurableObject"]
    }
  ]
}
