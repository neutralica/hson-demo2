{
  "name": "hson-demo2",
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "description": "interactive demo for hson-live and liveTree",
  "main": "index.js",
  "scripts": {
    "dev": "vite --mode frozen-local",
    "hosted:test-server": "tsx tests/harness/runtimes/node/server/hosted-test-server-entry.node.ts",
    "start:hosted-test-server": "tsx tests/harness/runtimes/node/server/hosted-test-server-entry.node.ts",
    "host": "osascript -e 'tell application \"Terminal\" to do script \"cd \\\"'\"$PWD\"'\\\" && npm run hosted:test-server\"' -e 'tell application \"Terminal\" to do script \"cd \\\"'\"$PWD\"'\\\" && npm run dev\"' -e 'tell application \"Terminal\" to activate'",
    "build:hson-live": "npm --prefix ../hson-live run build",
    "precheck": "npm run build:hson-live",
    "check": "tsc -p tsconfig.json --noEmit",
    "prebuild": "npm run build:hson-live",
    "build": "vite build",
    "test:cli": "node scripts/certified-package.mjs",
    "pack": "node scripts/certified-package.mjs pack",
    "certify": "node scripts/certified-package.mjs certify",
    "artifact:location": "node scripts/certified-package.mjs location",
    "build:node-production": "npm run build:hson-live && esbuild tests/harness/runtimes/node/server/hosted-test-server-production-entry.node.ts --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=dist-node/livehost-server.mjs && esbuild tests/harness/runtimes/node/circuit-verification-worker.mjs --bundle --platform=node --format=esm --packages=external --target=node22 --outfile=dist-node/circuit-verification-worker.mjs",
    "start:production": "node dist-node/livehost-server.mjs",
    
    "check:cloudflare": "tsc -p tsconfig.cloudflare.json --noEmit",
    "cloudflare:dev": "wrangler dev --config wrangler.jsonc",
    "cloudflare:deploy": "wrangler deploy --config wrangler.jsonc",
    "preflight:cloudflare": "test -n \"${CLOUDFLARE_API_TOKEN:-}\" || (echo 'CLOUDFLARE_API_TOKEN is required for Worker deployment.' >&2; exit 1)",
    "cloudflare:types": "wrangler types --config wrangler.jsonc --include-runtime false tests/harness/runtimes/cloudflare/worker-configuration.d.ts",
    "deploy:worker": "npm run build:hson-live && npm run check:cloudflare && npm run preflight:cloudflare && npm run cloudflare:deploy",
    "preview": "vite preview",

    "diagnose:towl-deployed": "tsx tests/runners/towl/diagnose-deployed-towl.node.mts",
    "test:towl": "tsx tests/runners/towl/run-towl-suites.node.mts",
    "test:towl-room": "tsx tests/runners/towl/run-towl-room-suite.node.mts",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed",
    "test:browser:debug": "PWDEBUG=1 playwright test",
    "test:browser:install": "playwright install chromium",
    "test:replay-node": "tsx tests/runners/livemap/run-replay-suite.node.mts",
    "test:reflect-keyed-node": "node --import=tsx tests/runners/reflect/run-keyed-projection.node.mts",
